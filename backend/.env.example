# ─── Database (Neon PostgreSQL — POOLED connection only) ───────────────────────
# IMPORTANT: Use the **pooled** URL (port is embedded as HTTPS/443 via Neon's pooler).
# Do NOT use the unpooled URL for the app — it will timeout in serverless/cloud envs.
DATABASE_URL='postgresql://<user>:<password>@<pooler-host>/neondb?sslmode=require&channel_binding=require'

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate your own: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET='your_jwt_secret_here'
GOOGLE_CLIENT_ID='your_google_oauth_client_id.apps.googleusercontent.com'

# ─── Cloudinary (image uploads + OCR evidence) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── NVIDIA AI API (OpenAI-compatible — used for scam analysis) ────────────────
# Get key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=moonshotai/kimi-k3

# ─── CORS (allowed origins separated by comma) ─────────────────────────────────
CORS_ORIGIN=https://scamtrace-hackathon.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:8000
